# ===== 必填 =====
# Bark 推送 key，从 Bark App 首页的推送地址里取（https://api.day.app/<这里就是 key>）
BARK_KEY=your_bark_key

# TeslaMate 数据库连接串。注意用容器网络内的主机名和端口
# 不知道该填什么？先跑 ./scripts/install-existing.sh --dry-run 自动探测，
# 或参考 docs/configuration.md 里的「从哪里获取」。
TESLAMATE_DATABASE_URL=postgresql://teslamate:password@database:5432/teslamate

# ===== 可选：推送行为 =====
# 自建 Bark 服务端时改这个
# BARK_SERVER=https://api.day.app
# 点击通知跳转的地址，通常填你的 TeslaMate 或 Grafana 面板公网地址
# BARK_CLICK_URL=https://teslamate.example.com
# 通知分组名，用于在 Bark 里归类
# NOTIFY_GROUP=特斯拉小管家

# ===== 可选：连接 =====
# TeslaMate 的 MQTT 地址
# MQTT_URL=mqtt://mosquitto:1883
# 时区，影响小结/月报的日期归属
# TIME_ZONE=Asia/Shanghai

# ===== 可选：阈值 =====
# 胎压提醒阈值（bar），低于此值推送
# TPMS_THRESHOLD_BAR=2.6
# 低电量提醒阈值（%）
# LOW_BATTERY_PERCENT=20
# 未锁车判定：停车超过多少分钟仍未休眠就提醒
# UNLOCK_ALERT_MINUTES=30
# 低电量提醒起始小时（24 小时制）
# LOW_BATTERY_HOUR=21
# 每日小结起始小时；若该时刻正在开车，则每小时顺延
# DAILY_SUMMARY_HOUR=21

# ===== 可选：费用 =====
# 首次启动时若没有电价记录，用这个值初始化（元/度）
# DEFAULT_ELECTRICITY_PRICE=0.36

# ===== 可选：数据目录 =====
# 状态文件存放位置，容器部署时挂载出来即可持久化
# DATA_DIR=/data
# 整体迁移运行目录时使用；DATA_DIR 未指定则取 <DATA_ROOT>/data
# DATA_ROOT=/opt/teslamate-bark

# ===== 可选：索引自检 =====
# TeslaMate v4+ 把 positions 的索引换成了 BRIN，按行程查询会退化成全表扫描。
# 默认在启动期自动补齐 B-tree 索引；数据库账号无建索引权限时设 false，
# 改由管理员手动执行 docs/configuration.md 里的 SQL。
# ENSURE_INDEXES=false
